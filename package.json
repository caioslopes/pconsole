{
  "name": "pconsole",
  "version": "0.1.0",
  "description": "Console mode automation service for a Windows gaming PC.",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "tv:activate": "tsx src/commands/activateTv.ts",
    "tv:inputs": "tsx src/commands/listTvInputs.ts",
    "tv:pair": "tsx src/commands/pairTv.ts",
    "tv:wake": "tsx src/commands/wakeTv.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
